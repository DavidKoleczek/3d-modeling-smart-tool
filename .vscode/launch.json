{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Windows app (sandbox)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=Modeling3DSetup"],
                "cwd": "${workspaceFolder}/windows"
            },
            "args": ["--sandbox", "${workspaceFolder}/temp/windows-sandbox"],
            "cwd": "${workspaceFolder}/windows"
        },
        {
            "name": "Windows app tray (sandbox)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": ["build", "--bin=Modeling3DSetup"],
                "cwd": "${workspaceFolder}/windows"
            },
            "args": ["--sandbox", "${workspaceFolder}/temp/windows-sandbox", "--background"],
            "cwd": "${workspaceFolder}/windows"
        }
    ]
}